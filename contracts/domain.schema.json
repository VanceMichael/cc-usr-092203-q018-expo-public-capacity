{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "东博会公众承载共享资料",
  "type": "object",
  "required": [
    "domain",
    "version",
    "sample_id",
    "actors",
    "facts",
    "constraints",
    "zones",
    "entrances",
    "corridors",
    "exhibits",
    "demo_slots",
    "staff"
  ],
  "properties": {
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "sample_id": {
      "type": "string",
      "minLength": 1
    },
    "actors": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string"
      }
    },
    "facts": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string"
      }
    },
    "constraints": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string"
      }
    },
    "zones": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "capacity"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "capacity": { "type": "integer", "minimum": 1 }
        },
        "additionalProperties": false
      }
    },
    "entrances": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "zones"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "zones": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "additionalProperties": false
      }
    },
    "corridors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "from", "to", "capacity"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "from": { "type": "string", "minLength": 1 },
          "to": { "type": "string", "minLength": 1 },
          "capacity": { "type": "integer", "minimum": 1 }
        },
        "additionalProperties": false
      }
    },
    "exhibits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "zone", "name", "interactive", "category"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "zone": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "interactive": { "type": "boolean" },
          "category": { "enum": ["科普展示", "零售"] }
        },
        "additionalProperties": false
      }
    },
    "demo_slots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["exhibit", "slot", "capacity"],
        "properties": {
          "exhibit": { "type": "string", "minLength": 1 },
          "slot": { "type": "string", "minLength": 1 },
          "capacity": { "type": "integer", "minimum": 1 }
        },
        "additionalProperties": false
      }
    },
    "staff": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["role", "scope", "capabilities"],
        "properties": {
          "role": { "type": "string", "minLength": 1 },
          "scope": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "capabilities": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
